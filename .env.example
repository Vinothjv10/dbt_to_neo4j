# ═══════════════════════════════════════════════════════════════════════
# Neo4j Connection (REQUIRED — needed for push-lineage)
# ═══════════════════════════════════════════════════════════════════════
NEO4J_URI=bolt://localhost:7687       # Address of your Neo4j database
NEO4J_USER=neo4j                      # Your Neo4j username
NEO4J_PASSWORD=password               # Your Neo4j password

# ═══════════════════════════════════════════════════════════════════════
# PostgreSQL Connection (OPTIONAL — only needed for PG→Neo4j schema sync)
# ═══════════════════════════════════════════════════════════════════════
PG_DSN=postgresql://user:pass@localhost:5432/mydb

# ═══════════════════════════════════════════════════════════════════════
# Paths (change only if you moved config files)
# ═══════════════════════════════════════════════════════════════════════
TABLES_CONFIG=config/tables.yaml
SETTINGS_CONFIG=config/settings.yaml